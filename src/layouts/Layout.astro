<style is:global>
    body{
    background-color: #E8D8BF;
    background-image: url(/assets/img/asfalt-dark.png);
  }

  .container{
    max-width: 1200px;
    margin:auto;
    padding: 20px;
  }
  .primary{
    color:#556320
  }
  @font-face {
    font-family: "Cookie";
    src: url("/Poppins-Regular.ttf");
  }
  h1,
  h2,
  h3,
  h4,
  h5,
  h6, .font {
    text-align: center;
    font-family: "Cookie", monospace;
  }

  h6 {
  }
  h3 {
    font-size: 2.4rem;
  }
  * {
    /* font-family: "Dancing Script", cursive; */
    font-family: "Roboto Flex", monospace;

    font-size: 1rem;
    color: #333;
  }
  .offcanvas-wide {
    width: 800px !important; /* Ajusta este valor según tus necesidades */
  }

  ul{
    padding-left:18px;
    margin-top:0
  }
  .row {
    display: grid;
    /* flex-wrap: wrap; */
    /* justify-content: start; */
    grid-template-columns: 1fr 1fr 1fr;
    gap: 20px;
   
        @media (max-width: 1080px) {
            grid-template-columns: 1fr 1fr;
        }

    @media (max-width: 770px) {
      grid-template-columns: 1fr;
    }
    img{
      max-width: 100%;
      border-radius: 15px;
    }
  }

  .fw-bold{
    font-weight: bold;
  }

   .page-title {
    font-size: 5rem;
    color: #556320;
    line-height: 3rem;
  }
  

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
</style>
