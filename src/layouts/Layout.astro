<script>
  // Destino fijo: Carrer d'Aragó 589, Barcelona (obtenido vía Nominatim)
  const DESTINATION = { lat: 41.4080302, lon: 2.1858506 };
  const BASE_PRICE = 8;
  const PRICE_PER_KM = 0.7;

  const input = document.getElementById("delivery-address") as HTMLInputElement | null;
  const button = document.getElementById("delivery-calculate-btn") as HTMLButtonElement | null;
  const result = document.getElementById("delivery-result");
  const suggestionsList = document.getElementById("delivery-suggestions") as HTMLUListElement | null;

  // Coordenadas de la sugerencia seleccionada, para evitar geocodificar de nuevo
  let selectedOrigin: { lat: number; lon: number } | null = null;
  let selectedAddress = "";
  let suggestAbortController: AbortController | null = null;
  let debounceTimer: ReturnType<typeof setTimeout> | undefined;

  async function fetchSuggestions(address: string) {
    suggestAbortController?.abort();
    suggestAbortController = new AbortController();
    const url = `https://nominatim.openstreetmap.org/search?format=json&limit=5&addressdetails=1&accept-language=es&countrycodes=es&q=${encodeURIComponent(
      address
    )}`;
    const res = await fetch(url, {
      headers: { Accept: "application/json" },
      signal: suggestAbortController.signal,
    });
    if (!res.ok) throw new Error("suggest-failed");
    return res.json();
  }

  function clearSuggestions() {
    if (suggestionsList) suggestionsList.innerHTML = "";
  }

  // Construye una etiqueta corta a partir de los componentes estructurados,
  // evitando que Nominatim repita la ciudad (p.ej. "Barcelona, Barcelonés, Barcelona, Cataluña")
  function formatSuggestion(item: any) {
    const addr = item.address || {};
    const street = [addr.road, addr.house_number].filter(Boolean).join(" ");
    const locality = addr.city || addr.town || addr.village || addr.municipality || addr.suburb;
    const parts = [street, locality].filter(Boolean);
    return parts.length ? parts.join(", ") : item.display_name;
  }

  function renderSuggestions(items: any[]) {
    if (!suggestionsList) return;
    suggestionsList.innerHTML = "";
    items.forEach((item) => {
      const label = formatSuggestion(item);
      const li = document.createElement("li");
      li.textContent = label;
      li.addEventListener("click", () => {
        if (!input) return;
        input.value = label;
        selectedOrigin = { lat: parseFloat(item.lat), lon: parseFloat(item.lon) };
        selectedAddress = label;
        clearSuggestions();
      });
      suggestionsList.appendChild(li);
    });
  }

  input?.addEventListener("input", () => {
    selectedOrigin = null;
    const address = input.value.trim();
    clearTimeout(debounceTimer);
    if (address.length < 3) {
      clearSuggestions();
      return;
    }
    debounceTimer = setTimeout(async () => {
      try {
        const items = await fetchSuggestions(address);
        renderSuggestions(items);
      } catch (err) {
        // Ignoramos peticiones abortadas o fallidas: el usuario sigue escribiendo
      }
    }, 350);
  });

  document.addEventListener("click", (e) => {
    if (!suggestionsList || !input) return;
    const target = e.target as Node;
    if (target !== input && !suggestionsList.contains(target)) {
      clearSuggestions();
    }
  });

  async function geocode(address: string) {
    if (selectedOrigin && address === selectedAddress) return selectedOrigin;
    const url = `https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${encodeURIComponent(
      address
    )}`;
    const res = await fetch(url, { headers: { Accept: "application/json" } });
    if (!res.ok) throw new Error("geocode-failed");
    const data = await res.json();
    if (!data.length) throw new Error("address-not-found");
    return { lat: parseFloat(data[0].lat), lon: parseFloat(data[0].lon) };
  }

  async function getDistanceKm(origin: { lat: number; lon: number }) {
    const url = `https://router.project-osrm.org/route/v1/driving/${origin.lon},${origin.lat};${DESTINATION.lon},${DESTINATION.lat}?overview=false`;
    const res = await fetch(url);
    if (!res.ok) throw new Error("route-failed");
    const data = await res.json();
    if (!data.routes || !data.routes.length) throw new Error("route-not-found");
    return data.routes[0].distance / 1000;
  }

  async function calculate() {
    if (!input || !result || !button) return;
    const address = input.value.trim();
    if (!address) {
      result.textContent = "Escribe una dirección para calcular el precio.";
      return;
    }

    button.disabled = true;
    result.textContent = "Calculando...";

    try {
      const origin = await geocode(address);
      const km = await getDistanceKm(origin);
      const price = BASE_PRICE + km * PRICE_PER_KM;
      result.textContent = `Distancia: ${km.toFixed(1)} km — Precio de entrega: ${price.toFixed(
        2
      )}€`;
    } catch (err) {
      result.textContent =
        "No se ha podido calcular la distancia. Comprueba la dirección e inténtalo de nuevo.";
    } finally {
      button.disabled = false;
    }
  }

  button?.addEventListener("click", calculate);
  input?.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      clearSuggestions();
      calculate();
    }
    if (e.key === "Escape") clearSuggestions();
  });
</script>

<style>
  .delivery-calculator {
    margin-top: 1rem;
  }
  .delivery-calculator-form {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
  }
  .delivery-address-wrap {
    position: relative;
    flex: 1;
    min-width: 220px;
  }
  .delivery-address-wrap input {
    width: 100%;
    padding: 8px 12px;
    border-radius: 8px;
    border: 1px solid #556320;
    font-size: 1rem;
    box-sizing: border-box;
  }
  .delivery-suggestions {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 10;
    background-color: #fff;
    border: 1px solid #556320;
    border-radius: 8px;
    max-height: 240px;
    overflow-y: auto;
  }
  .delivery-suggestions:empty {
    display: none;
    border: none;
  }
  .delivery-suggestions :global(li) {
    padding: 8px 12px;
    font-size: 0.95rem;
    cursor: pointer;
  }
  .delivery-suggestions :global(li:hover) {
    background-color: #e8d8bf;
  }
  .delivery-calculator-form button {
    padding: 8px 16px;
    border-radius: 8px;
    border: none;
    background-color: #556320;
    color: #fff;
    cursor: pointer;
  }
  .delivery-calculator-form button:disabled {
    opacity: 0.6;
    cursor: default;
  }
  #delivery-result {
    margin-top: 10px;
    font-weight: bold;
  }
</style>

